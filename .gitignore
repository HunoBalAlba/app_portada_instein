cd "/home/kat/proyectos reflex/proyecto_instein/app_portada_instein"

cat > .gitignore << 'EOF'
# =====================================================================
# .gitignore para INSTEIN
# =====================================================================

# --- Reflex ---
.web
web/
.states
*.db

# --- Python-generated files ---
*.py[cod]
*.py[oc]
__pycache__/
*.egg-info
build/
dist/
wheels/
.eggs/
*.so
.Python

# --- Virtual environments ---
.venv
venv/
ENV/
env/

# --- Testing / Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage_annotate/
.tox/
.nox/

# --- Ruff ---
.ruff_cache/

# --- Type checkers ---
.mypy_cache/
.dmypy.json
dmypy.json

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Entornos / secretos ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Assets externos ---
assets/external/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
EOF

echo "✅ .gitignore actualizado"
wc -l .gitignore